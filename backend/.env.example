# Server
PORT=4000

# Auth (REQUIRED — set a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS — the URL of the deployed frontend (or localhost during dev)
FRONTEND_URL=http://localhost:3000

# PostgreSQL — REQUIRED (used for both local dev and production)
# Create a free database on Neon (https://neon.tech) and paste its connection string.
# ⚠️ Keep the params as `?sslmode=require` — REMOVE any `&channel_binding=require`
#    (it breaks Prisma Migrate's advisory locking on Neon's pooled endpoint).
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/cinevault?sslmode=require
