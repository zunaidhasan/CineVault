# Server
PORT=4000

# Auth (REQUIRED — set a long random string, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# CORS — the URL of the deployed frontend (or localhost during dev)
FRONTEND_URL=http://localhost:3000

# PostgreSQL — only required in production (also switch provider in schema.prisma)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
